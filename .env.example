# ---------------------------------------------------------------------------
# Vridhi Construction: environment configuration
# Copy to .env.local (local) or set in your host's dashboard (production).
# Only VERIFIED values belong here. Anything left blank is simply not shown.
# ---------------------------------------------------------------------------

# Public site address, used for canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Contact (public) ------------------------------------------------------
# Phone in E.164 format (+91 then 10 digits, no spaces). Powers tel: links.
NEXT_PUBLIC_PHONE_E164=
# How the number is displayed, e.g. "+91 98765 43210"
NEXT_PUBLIC_PHONE_DISPLAY=
# WhatsApp number, digits only, international format, NO plus sign (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_EMAIL=

# --- Business details (public; must match the Google Business Profile) ------
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_POSTAL=
NEXT_PUBLIC_PRIMARY_CITY=Dehradun
NEXT_PUBLIC_REGION=Uttarakhand
# Comma-separated cities with genuine service coverage, e.g. "Dehradun,Rishikesh"
NEXT_PUBLIC_SERVICE_AREAS=
# Semicolon-separated lines, e.g. "Monday to Saturday, 10:00 to 18:00;Sunday, by appointment"
NEXT_PUBLIC_BUSINESS_HOURS=

# --- Profiles (public) -----------------------------------------------------
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# --- Enquiry delivery (PRIVATE: server only, never prefix with NEXT_PUBLIC) --
# Option A: email through Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
# Option B: POST each enquiry as JSON to a webhook (CRM, Zapier, Make, n8n ...)
ENQUIRY_WEBHOOK_URL=
# If neither option is configured, the form reports a clear failure rather than
# pretending to succeed.

# --- Content ---------------------------------------------------------------
# Shows clearly-labelled SAMPLE projects, articles and reviews for layout
# preview. Leave unset/false in production.
SHOW_SAMPLE_CONTENT=false
